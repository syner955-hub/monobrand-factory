# AI API для генерации контента
# Поддерживает OpenAI-совместимые API (OpenAI, Claude через прокси, и т.д.)

# API ключ
OPENAI_API_KEY=sk-your-key-here

# Base URL (по умолчанию OpenAI, можно заменить на Claude прокси)
OPENAI_BASE_URL=https://api.vibecode-claude.online/v1

# Модель (claude-opus-4-20250514, gpt-4o-mini, gpt-4o, и т.д.)
AI_MODEL=claude-opus-4-20250514
